# Docker environment for orphanet-link behind Nginx Proxy Manager.
# Copy to .env.docker for the NPM compose deployment:
#
#   cp .env.docker.example .env.docker
#
# ORPHANET_LINK_IMAGE is required; every other key is optional (the image and
# docker/docker-compose.npm.yml carry safe defaults), so this file otherwise just
# pins the external NPM network and lets you tune data bootstrap, logging, and
# resource limits without editing the compose file.

# --- Released Image (required) ---
# The NPM and prod deployments pull the released, attested image from GHCR; they
# never build. Pin a DIGEST, not a tag: there is no `latest`, and only a digest is
# immutable. Resolve it from the release asset `application-release-manifest.json`
# (.image.digest), or:
#   docker buildx imagetools inspect ghcr.io/berntpopp/orphanet-link:<version>
# The placeholder below is not a real digest — replace it before deploying; it exists
# only so `compose config` can render without weakening the fail-closed guard.
ORPHANET_LINK_IMAGE=ghcr.io/berntpopp/orphanet-link@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# ---- Nginx Proxy Manager (docker/docker-compose.npm.yml) ----
# External NPM network the container joins for reverse-proxy routing.
NPM_SHARED_NETWORK_NAME=npm_default

# ---- Data bootstrap (docker/docker-compose.yml + npm.yml) ----
# Base URL for Orphadata English XML scientific-knowledge files.
# ORPHANET_LINK_DATA__BASE_URL=https://www.orphadata.com/data/xml/

# Prefer the prebuilt SQLite DB from the GitHub Release over a local build.
# ORPHANET_LINK_DATA__PREFER_PREBUILT=true

# GitHub owner/repo hosting the prebuilt database release assets.
# ORPHANET_LINK_DATA__RELEASE_REPO=berntpopp/orphanet-link

# Production release pin (the Compose overlays use these exact values):
#   tag:      data-1.3.42-4.1.8-2025-03-03-r20260623T075350Z-r2
#   bundle:   cc32164c7f64bfb053fabdb2c739ff0236cc039000d3827e7c64160d70dec62f
#   manifest: e1ecd0e6687356f20cc7221a832905674176a428377f248146bc2a1c8f9a1b89
#   checksum: 7080bb94267b013b73ee9f9ee1f5513d9deda9ce2f577734a77f99e7d750c9f4
#   expanded: d7408be62d055700901e635c1582c3ccdf5245e87b88f53c90f8fbdb2f284a53
# Development may resolve the newest release with:
# ORPHANET_LINK_DATA__RELEASE_TAG=latest
#
# The overlays inject the tag + bundle digest on BOTH the init sidecar (which fetches
# and verifies them) and the application (which only PROVES them): together they switch
# on the runtime-v1 data identity contract, so /health publishes `release_identity` and
# answers 503 if the volume holds anything else. Do not set them here.

# ---- Deployed data volume (docker/docker-compose.npm.yml) ----
# Physical Docker volume name behind the `orphanet-data` logical volume. The fleet
# controller switches this to activate a candidate volume holding a NEW data release;
# the default is the volume live on the server today. Read by Compose, not by the app.
# ORPHANET_DATA_VOLUME=orphanet-link-npm_orphanet-data

# ---- Server (docker/docker-compose.yml standalone) ----
# Host port published by the standalone compose file.
# ORPHANET_LINK_HOST_PORT=8000

# ---- Logging ----
LOG_LEVEL_API=INFO

# ---- NPM resource limits (optional) ----
ORPHANET_API_MEMORY_LIMIT=1g
ORPHANET_API_CPU_LIMIT=1.0
